# Per-tenant otel-collector manifests, server-side-applied by the onboarding
# provisioner. Generated with `kubectl kustomize` from the CLI tenant template
# (optikk/assets/deploy/tenants/_template) — keep the two in sync.
# .Instance is "<team slug>-<team id>" (slug alone is not globally unique).
apiVersion: v1
data:
  config.yaml: |
    receivers:
      otlp:
        protocols:
          grpc:
            endpoint: "0.0.0.0:4317"
            include_metadata: true
          http:
            endpoint: "0.0.0.0:4318"
            include_metadata: true

    processors:
      memory_limiter:
        check_interval: 1s
        limit_percentage: 80
        spike_limit_percentage: 25
      batch:
        send_batch_size: 1000
        timeout: 10s
      cumulativetodelta:
      transform/db:
        error_mode: ignore
        trace_statements:
          - context: span
            statements:
              - set(attributes["db.statement.normalized"], attributes["db.statement"]) where attributes["db.statement"] != nil
              - replace_pattern(attributes["db.statement.normalized"], "\\b\\d+\\b", "?") where attributes["db.statement.normalized"] != nil
              - replace_pattern(attributes["db.statement.normalized"], "'[^']*'", "?") where attributes["db.statement.normalized"] != nil
      filter/noise:
        error_mode: ignore
        traces:
          span:
            - 'IsMatch(attributes["http.route"], "^/(health|healthz|livez|readyz|metrics)$")'
      redaction:
        allow_all_keys: true
        blocked_values:
          - "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b"
          - "\\b(?:\\d[ -]*?){13,16}\\b"
        summary: silent

    connectors:
      spanmetrics:
        aggregation_temporality: "AGGREGATION_TEMPORALITY_DELTA"
        histogram:
          explicit:
            buckets: [2ms, 4ms, 6ms, 8ms, 10ms, 50ms, 100ms, 200ms, 400ms, 800ms, 1s, 1400ms, 2s, 5s, 10s, 15s]
        dimensions:
          - name: http.method
          - name: http.status_code
          - name: http.route
          - name: messaging.system
          - name: messaging.operation
          - name: messaging.destination.name
          - name: messaging.consumer.group.name
          - name: db.system
          - name: db.namespace
          - name: db.collection.name
          - name: server.address
      servicegraph:
        latency_histogram_buckets: [2ms, 4ms, 6ms, 8ms, 10ms, 50ms, 100ms, 200ms, 400ms, 800ms, 1s, 1400ms, 2s, 5s, 10s, 15s]
        dimensions:
          - status.code
        store:
          ttl: 2s
          max_items: 1000
      exceptions:
      count:
        logs:
          log.record.count:
            description: Total log records
          log.records.errors:
            description: Error-or-higher severity log records
            conditions:
              - 'severity_number >= SEVERITY_NUMBER_ERROR'

    extensions:
      headers_setter:
        headers:
          - action: upsert
            key: x-api-key
            value: ${env:OPTIKK_API_KEY}
      health_check:
        endpoint: 0.0.0.0:13133
      pprof:
        endpoint: 0.0.0.0:1777
      zpages:
        endpoint: 0.0.0.0:55679
      file_storage/queue:
        directory: /var/lib/otelcol/storage
        create_directory: true

    exporters:
      otlp/optikk:
        endpoint: "ingest:4318"
        tls:
          insecure: true
        auth:
          authenticator: headers_setter
        sending_queue:
          enabled: true
          storage: file_storage/queue
        retry_on_failure:
          enabled: true

    service:
      extensions: [headers_setter, health_check, pprof, zpages, file_storage/queue]
      telemetry:
        metrics:
          level: detailed
          readers:
            - pull:
                exporter:
                  prometheus:
                    host: 0.0.0.0
                    port: 8888
      pipelines:
        traces:
          receivers: [otlp]
          processors: [memory_limiter]
          exporters: [spanmetrics, servicegraph, exceptions]
        traces/storage:
          receivers: [otlp]
          processors: [memory_limiter, transform/db, filter/noise, redaction, batch]
          exporters: [otlp/optikk]
        metrics:
          receivers: [otlp, spanmetrics, servicegraph, exceptions, count]
          processors: [memory_limiter, cumulativetodelta, batch]
          exporters: [otlp/optikk]
        logs:
          receivers: [otlp, exceptions]
          processors: [memory_limiter, batch]
          exporters: [otlp/optikk, count]
kind: ConfigMap
metadata:
  labels:
    tenant: {{ .Instance }}
  name: otel-collector-config-{{ .Instance }}
  namespace: optikk
---
apiVersion: v1
kind: Secret
metadata:
  labels:
    tenant: {{ .Instance }}
  name: otel-collector-secret-{{ .Instance }}
  namespace: optikk
stringData:
  api-key: {{ .APIKey }}
type: Opaque
---
apiVersion: v1
kind: Service
metadata:
  labels:
    app: otel-collector
    tenant: {{ .Instance }}
  name: otel-collector-{{ .Instance }}
  namespace: optikk
spec:
  ports:
  - name: otlp-grpc
    port: 4317
    targetPort: 4317
  - name: otlp-http
    port: 4318
    targetPort: 4318
  - name: health
    port: 13133
    targetPort: 13133
  - name: metrics
    port: 8888
    targetPort: 8888
  selector:
    app: otel-collector
    tenant: {{ .Instance }}
  type: ClusterIP
---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    tenant: {{ .Instance }}
  name: otel-collector-{{ .Instance }}
  namespace: optikk
spec:
  replicas: 1
  selector:
    matchLabels:
      app: otel-collector
      tenant: {{ .Instance }}
  template:
    metadata:
      labels:
        app: otel-collector
        tenant: {{ .Instance }}
    spec:
      containers:
      - args:
        - --config=/etc/otelcol-contrib/config.yaml
        env:
        - name: GOMEMLIMIT
          value: 400MiB
        - name: OPTIKK_API_KEY
          valueFrom:
            secretKeyRef:
              key: api-key
              name: otel-collector-secret-{{ .Instance }}
        image: otel/opentelemetry-collector-contrib:0.155.0
        livenessProbe:
          httpGet:
            path: /
            port: 13133
          initialDelaySeconds: 15
          periodSeconds: 15
        name: otel-collector
        ports:
        - containerPort: 4317
          name: otlp-grpc
        - containerPort: 4318
          name: otlp-http
        - containerPort: 13133
          name: health
        - containerPort: 8888
          name: metrics
        readinessProbe:
          httpGet:
            path: /
            port: 13133
          initialDelaySeconds: 5
          periodSeconds: 5
        resources:
          limits:
            memory: 512Mi
          requests:
            cpu: 100m
            memory: 256Mi
        volumeMounts:
        - mountPath: /etc/otelcol-contrib
          name: config
        - mountPath: /var/lib/otelcol/storage
          name: queue
      volumes:
      - configMap:
          name: otel-collector-config-{{ .Instance }}
        name: config
      - emptyDir: {}
        name: queue
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  labels:
    tenant: {{ .Instance }}
  name: otel-collector-{{ .Instance }}
  namespace: optikk
spec:
  maxReplicas: 5
  metrics:
  - resource:
      name: cpu
      target:
        averageUtilization: 70
        type: Utilization
    type: Resource
  - resource:
      name: memory
      target:
        averageUtilization: 80
        type: Utilization
    type: Resource
  minReplicas: 1
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: otel-collector-{{ .Instance }}
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  labels:
    tenant: {{ .Instance }}
  name: otlp-grpc-{{ .Instance }}
  namespace: optikk
spec:
  entryPoints:
  - otlp-grpc
  routes:
  - kind: Rule
    match: Header(`x-api-key`, `{{ .APIKey }}`)
    middlewares:
    - name: ratelimit
    services:
    - name: otel-collector-{{ .Instance }}
      port: 4317
      scheme: h2c
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  labels:
    tenant: {{ .Instance }}
  name: otlp-http-{{ .Instance }}
  namespace: optikk
spec:
  entryPoints:
  - otlp-http
  routes:
  - kind: Rule
    match: Header(`x-api-key`, `{{ .APIKey }}`)
    middlewares:
    - name: ratelimit
    services:
    - name: otel-collector-{{ .Instance }}
      port: 4318
